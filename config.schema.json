{
  "pluginAlias": "TuyaIRLocal",
  "pluginType": "platform",
  "headerDisplay": "**Control your Tuya Smart IR based devices in HomeKit. Also works with Smart Home IR Blaster. You can add multiple Smart IR device to single configuration.**",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "required": true,
        "default": "TuyaIR"
      },
      "tuyaAPIClientId": {
        "title": "Client ID",
        "type": "string",
        "required": false,
        "default": "",
        "description": "Your Tuya IOT cloud project's client ID. Required when autoFetchRemotesFromServer is enabled."
      },
      "tuyaAPISecret": {
        "title": "Client Secret",
        "type": "string",
        "required": false,
        "default": "",
        "description": "Your Tuya IOT cloud project's secret. Required when autoFetchRemotesFromServer is enabled."
      },
      "deviceRegion": {
        "title": "Device Region",
        "type": "string",
        "required": false,
        "default": "",
        "oneOf": [
          {
            "title": "India",
            "enum": [
              "in"
            ]
          },
          {
            "title": "Europe",
            "enum": [
              "eu"
            ]
          },
          {
            "title": "China",
            "enum": [
              "cn"
            ]
          },
          {
            "title": "America",
            "enum": [
              "us"
            ]
          }
        ]
      },
      "smartIR": {
        "title": "List of Smart IR Devices",
        "type": "array",
        "items": {
          "type": "object",
          "title": "Smart IR Details",
          "properties": {
            "deviceId": {
              "title": "Smart IR Device ID",
              "type": "string",
              "required": true,
              "default": "",
              "description": "Device ID of the Smart IR Blaster"
            },
            "localKey": {
              "title": "Local Key",
              "type": "string",
              "required": true,
              "default": "",
              "description": "32-character local encryption key for this IR blaster. Get this from Tuya IoT Platform > Cloud > Devices > Device Information."
            },
            "ip": {
              "title": "IP Address",
              "type": "string",
              "required": false,
              "description": "Local IP address of the IR blaster (e.g. 192.168.1.50). Required for protocol v3.4/v3.5. Leave empty to use auto-discovery with v3.3."
            },
            "version": {
              "title": "Protocol Version",
              "type": "string",
              "required": false,
              "default": "3.3",
              "oneOf": [
                { "title": "3.3 (auto-discover IP)", "enum": ["3.3"] },
                { "title": "3.4 (requires IP)", "enum": ["3.4"] },
                { "title": "3.5 (requires IP)", "enum": ["3.5"] }
              ],
              "description": "Tuya local protocol version used by your IR blaster. v3.3 supports IP auto-discovery. v3.4/v3.5 require an explicit IP address."
            },
            "autoFetchRemotesFromServer": {
              "title": "Fetch configured remotes automatically?",
              "type": "boolean",
              "required": true,
              "default": true,
              "description": "Uncheck this box if your IR remotes are not discovered automatically. You will need to add your remote IDs manually below"
            },
            "configuredRemotes": {
              "title": "List of configured Smart IR Remotes",
              "type": "array",
              "items": {
                "type": "object",
                "title": "Remote Details",
                "properties": {
                  "id": {
                    "title": "Remote Id",
                    "type": "string",
                    "description": "Remote ID",
                    "required": true
                  },
                  "diy": {
                    "title": "Is this Remote DIY?",
                    "type": "boolean",
                    "required": true
                  },
                  "model": {
                    "title": "Model",
                    "type": "string",
                    "required": false,
                    "default": "Unknown",
                    "description": "Model of the Remote"
                  },
                  "brand": {
                    "title": "Brand",
                    "type": "string",
                    "required": false,
                    "default": "Unknown",
                    "description": "Brand of the Remote"
                  }
                }
              },
              "condition": {
                "functionBody": "return model.smartIR[arrayIndices].autoFetchRemotesFromServer === false;"
              }
            }
          }
        }
      }
    }
  }
}